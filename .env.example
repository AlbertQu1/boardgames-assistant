# Postgres (casa db, boardgames schema)
# Sin host = conecta por socket local (peer auth, sin password) — corre en el mismo server.
DATABASE_URL=postgresql://albertqu@/casa

# API key de Gemini (aistudio.google.com/apikey, tier gratuito) — usada por source/api.py para /ask
GEMINI_API_KEY=

# Rol de Postgres de solo lectura (creado con GRANT SELECT en bgstats) — usado por la tool query_sql
DATABASE_URL_READONLY=postgresql://boardgames_readonly:PASSWORD@localhost/casa

# Calendario de visitas iCloud publicado (ICS) — usado por source/calendario_sync.py
VISITS_CALENDAR_URL=

# DB de la app Vacaciones (tabla vacation_trips) — usada por source/calendario_sync.py
# Sin host = conecta por socket local (peer auth, sin password)
VACATION_DB_URL=postgresql://albertqu@/vacaciones

# Token de aplicacion registrada en BGG (boardgamegeek.com/applications, seccion "Tokens")
# Header: Authorization: Bearer <token> — usado por source/bgg_cache_sync.py
BGG_API_TOKEN=
